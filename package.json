{
  "name": "carrot-patch-defense",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A cozy garden tower defense game.",
  "scripts": {
    "dev": "npx --yes serve web -l 5173",
    "fonts": "node scripts/fetch-fonts.mjs",
    "add:ios": "npx cap add ios",
    "add:android": "npx cap add android",
    "sync": "npx cap sync",
    "ios": "npx cap sync ios && npx cap open ios",
    "android": "npx cap sync android && npx cap open android",
    "new-game": "node scripts/new-game.mjs",
    "balance": "node tools/balance/run.js"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/preferences": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/ios": "^7.0.0"
  }
}
